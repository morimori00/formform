# Copied to server/.env by ./up.sh, which fills the empty secrets. .env is gitignored.

# Pinned Onyx release (MIT community edition). Change only as described in docs/SELF_HOSTING.md "アップグレード".
IMAGE_TAG=v5.1.1

# Where the server listens. Keep 127.0.0.1 behind a TLS reverse proxy; 0.0.0.0 exposes plain HTTP to the LAN.
FORMFORM_BIND=127.0.0.1
HOST_PORT=3080
# Public URL users type (used for OAuth redirects of connectors such as Google Drive).
WEB_DOMAIN=http://localhost:3080

# Secrets, generated on first run.
USER_AUTH_SECRET=
ENCRYPTION_KEY_SECRET=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=

# Nothing leaves the machine: no calls to Onyx-controlled endpoints, no telemetry, no MCP server,
# community (MIT) code paths only, files kept in PostgreSQL.
ONYX_AIRGAPPED=true
DISABLE_TELEMETRY=true
MCP_SERVER_ENABLED=false
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=false
FILE_STORE_BACKEND=postgres
COMPOSE_PROFILES=
